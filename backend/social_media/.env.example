APP_NAME=Social Media API
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./social_media.db
SECRET_KEY=replace-with-a-long-random-value
MESSAGE_ENCRYPTION_KEY=replace-with-a-fernet-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://localhost:6379/0
FEED_CACHE_TTL_SECONDS=30

# Links in verification and password-reset emails point here.
FRONTEND_URL=http://localhost:5173
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Leave SMTP_HOST empty to log emails and expose development action links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TickMe <no-reply@tickme.dev>
SMTP_USE_TLS=true

# Promote an existing account to Super Admin at startup (only when no Super Admin exists yet).
BOOTSTRAP_ADMIN_EMAIL=
